\name{smf_explain}\nalias{smf_explain}\nalias{smf_explain_spec}\nalias{smf_permutation_importance}\nalias{smf_pdp}\nalias{smf_ice}\nalias{smf_ale}\nalias{smf_local_explain}\nalias{smf_shap}\nalias{smf_counterfactual}\nalias{smf_trace_features}\nalias{smf_explanation_domain}\nalias{smf_explanation_agreement}\nalias{smf_explanation_stability}\ntitle{Explainable AI and explanation stability}\ndescription{Package-native explainability contracts for global and local predictive explanations, source-feature tracing, correlation and domain safeguards, and resampling-based explanation stability.}\n\usage{\nsmf_explain(result, data, spec = smf_explain_spec(), truth = NULL, new_data = NULL)\nsmf_explain_spec(methods = c("permutation", "pdp", "ale"), scope = c("both", "global", "local"), features = character(), background = c("training", "assessment", "explicit"), n_repeats = 20L, grid_size = 20L, ice_n = 50L, stability_resampling = NULL, seed = 260915L, parameters = list())\n}\ndetails{Every package-native explanation is predictive, not causal. Version 0.5.0 records \code{causal_interpretation = FALSE}, preserves feature provenance when mappings exist, warns about correlated-feature perturbations, and separates explanation magnitude from stability across design-aware resamples. Optional SHAP support uses \pkg{fastshap} when installed.}\n\value{An \code{ExplainResult}, \code{ExplanationStabilityResult}, or a method-specific data frame depending on the called function.}\n